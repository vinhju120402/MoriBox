# Copy to .env.local and fill in. Never commit .env.local.

# Public origin of the deployed site — used by sitemap.xml and robots.txt.
# Falls back to https://moribox.example.com when unset (which is wrong in production).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Dev only: comma-separated LAN hosts allowed to load the dev server
# (e.g. testing the PWA on a phone over Wi-Fi).
# ALLOWED_DEV_ORIGINS=192.168.1.10

# Supabase — Connect dialog or Project Settings → API Keys. Both values are safe for the browser
# (security comes from the Row Level Security rules in supabase/schema.sql).
# NEVER put the service_role key in any NEXT_PUBLIC_ variable or commit it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# The shop's bank account (for the VietQR code) and the shipping fee are no longer
# environment variables: an admin sets them in the app under Cài đặt cửa hàng.

# Optional, only for `npm run db:apply` (applies supabase/schema.sql for you).
# Create a personal access token at https://supabase.com/dashboard/account/tokens,
# paste it into .env.local (never commit it), run the command, then delete the token.
# SUPABASE_ACCESS_TOKEN=sbp_...
